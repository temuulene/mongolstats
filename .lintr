linters: lintr::linters_with_defaults(
  assignment_linter = NULL,
  line_length_linter = lintr::line_length_linter(145),
  object_name_linter = lintr::object_name_linter(styles = c("snake_case", "symbols")),
  commented_code_linter = NULL
 )
exclusions: list(
  "R/zzz.R",
  # Helper functions in this vignette use data-masked column names
  # (dplyr/sf), which object_usage_linter reports as undefined variables.
  # Name the file, not the directory: a directory entry excludes it entirely.
  "vignettes/ub-health-environment.Rmd" = list(object_usage_linter = Inf)
 )
